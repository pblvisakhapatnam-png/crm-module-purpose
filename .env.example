APP_ENV=development
BACKEND_PORT=8000

# PostgreSQL is the frozen production database (ADR-028).
# These three values initialize the PostgreSQL container and are also used by its health check.
POSTGRES_DB=pbl_crm_hiring
POSTGRES_USER=pbl_app
POSTGRES_PASSWORD=ChangeThisStrongPassword123!

# Canonical SQLAlchemy URL for the backend. Use the postgresql+psycopg dialect (Psycopg 3).
# A hosted provider URL using the bare postgresql:// or legacy postgres:// scheme is normalized
# to postgresql+psycopg automatically; any other dialect is rejected at startup.
# Leave DATABASE_URL unset to fall back to POSTGRES_HOST/PORT/DB/USER/PASSWORD defaults.
DATABASE_URL=postgresql+psycopg://pbl_app:ChangeThisStrongPassword123!@db:5432/pbl_crm_hiring

JWT_SECRET=change-this-in-real-use
JWT_EXPIRES_MINUTES=480

# Development and CI only: fewer password-hashing rounds, so the test suite's many sign-ins stay fast (a full
# backend run takes several times longer at the standard 600,000). The backend refuses to start with fewer than
# 600,000 in any other environment, so delete this line for one. It applies when the database's users are created:
# a user hashed at 600,000 stays so until the stack is recreated with `docker compose down -v`.
PASSWORD_HASH_ITERATIONS=10000

# Where uploaded documents are kept (Slice 9C). Left commented out, these defaults apply; "local"
# is the only provider today, and Compose keeps the folder on the named volume document-store.
# DOCUMENT_STORAGE_PROVIDER=local
# DOCUMENT_STORAGE_ROOT=/app/document-store

# Server-side only. The Vite server proxies browser /api requests to this target; it is never
# exposed to browser code, which always calls relative /api URLs. Docker Compose sets
# http://backend:8000 for the frontend service.
BACKEND_INTERNAL_URL=http://localhost:8000
