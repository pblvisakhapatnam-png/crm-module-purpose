# Production-style frontend image for the hosted CRM pilot (TE-5): builds the React application and
# serves the static files with nginx (nginx/default.conf). The development image (Dockerfile) is
# unchanged and keeps serving with `vite preview`, which suits development and the Playwright suite
# but is not a production server.
#
# Build arguments, read by the Vite build (src/config/buildFlags.ts):
#   VITE_HIDE_DEMO_CREDENTIALS  "true" (the default here) removes the demo sign-in details from the
#                               bundle. The build fails if a demo username is still in it.
#   VITE_PERIMETER_BASIC_AUTH   "true" when a shared Basic Auth login protects the whole site; see
#                               src/perimeter.ts. Default "false".

FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ARG VITE_HIDE_DEMO_CREDENTIALS=true
ARG VITE_PERIMETER_BASIC_AUTH=false
ENV VITE_HIDE_DEMO_CREDENTIALS=${VITE_HIDE_DEMO_CREDENTIALS} \
    VITE_PERIMETER_BASIC_AUTH=${VITE_PERIMETER_BASIC_AUTH}

RUN npm run build

# Fail closed. A bundle built to hide the demo sign-in details must not contain any of the six demo
# usernames that Alembic revision 20260629_0002 creates.
RUN if [ "$VITE_HIDE_DEMO_CREDENTIALS" = "true" ] \
      && grep -rqwE 'admin1|sales1|manager1|finance1|ops1|readonly1' dist; then \
      echo "Demo sign-in details were found in a bundle built to hide them." >&2; \
      exit 1; \
    fi

FROM nginx:1.30-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 3000
